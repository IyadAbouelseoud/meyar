{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meyar data contract",
  "type": "object",
  "required": [
    "patientId",
    "sampleOrigin",
    "genes"
  ],
  "additionalProperties": false,
  "properties": {
    "patientId": {
      "type": "string"
    },
    "sampleOrigin": {
      "const": "germline"
    },
    "genes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gene",
          "diplotype",
          "phenotype",
          "candidates",
          "coverage",
          "guidelineVersion"
        ],
        "additionalProperties": false,
        "properties": {
          "gene": {
            "type": "string"
          },
          "diplotype": {
            "type": [
              "string",
              "null"
            ]
          },
          "phenotype": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage": {
            "type": "object",
            "required": [
              "definingPositionsAssayed",
              "definingPositionsTotal",
              "untestedLocalAlleles",
              "uninformativeNormalRisk"
            ],
            "additionalProperties": false,
            "properties": {
              "definingPositionsAssayed": {
                "type": "integer",
                "minimum": 0
              },
              "definingPositionsTotal": {
                "type": "integer",
                "minimum": 0
              },
              "untestedLocalAlleles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "uninformativeNormalRisk": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "saudiDataTier": {
                "type": "integer",
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "saudiDataNote": {
                "type": "string"
              }
            }
          },
          "guidelineVersion": {
            "type": "string"
          },
          "callability": {
            "type": "object",
            "required": [
              "method",
              "svAssessed"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": [
                  "vcf",
                  "outside-call",
                  "not-assessed"
                ]
              },
              "svAssessed": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              },
              "requiredInput": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          },
          "effectivePhenotype": {
            "type": "string"
          },
          "phenoconversion": {
            "type": "object",
            "required": [
              "applied"
            ],
            "additionalProperties": false,
            "properties": {
              "applied": {
                "type": "boolean"
              },
              "cause": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inhibitorStrength": {
                "enum": [
                  "strong",
                  "moderate",
                  null
                ]
              },
              "geneticActivityScore": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "adjustedActivityScore": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "method": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "currentMedications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "mock"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "rxnorm": {
            "type": "string"
          },
          "source": {
            "enum": [
              "hospital-record",
              "patient-entered"
            ]
          },
          "mock": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
