# Netlify headers for the Passport (REVIEW 2026-11-24). Publish directory: passport/dist.
# Hashed build assets never change, so they can be cached for a year. Everything else is revalidated,
# so a new deploy (and the service worker's next install) always sees current files.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/imagery/*
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
