# Netlify headers for the Passport (REVIEW 2026-11-24).
# Hashed build assets never change, so they can be cached for a year. HTML, sw.js and demo data are
# revalidated so a new deploy is picked up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/imagery/*
  Cache-Control: public, max-age=604800
/sw.js
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
