{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meyar/tables/cpic_recommendations.schema.json",
  "title": "Meyar CPIC/DPWG recommendation table (owner: B1)",
  "type": "object",
  "required": ["_owner", "_note", "rows"],
  "additionalProperties": false,
  "properties": {
    "_owner": { "const": "B1" },
    "_note": { "type": "string" },
    "_gaps": {
      "description": "Known missing coverage, stated openly instead of filled by paraphrase.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["drug", "genes", "reason"],
        "additionalProperties": false,
        "properties": {
          "drug": { "type": "string" },
          "genes": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "geneMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "alternative": {
      "type": "object",
      "required": ["drug", "rxnorm", "kind", "condition", "source"],
      "additionalProperties": false,
      "properties": {
        "drug": { "type": "string", "minLength": 1 },
        "rxnorm": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "kind": {
          "description": "drug = a specific medicine named in the guideline text (rxnorm required); class = the text names only a class or a category (rxnorm null).",
          "enum": ["drug", "class"]
        },
        "condition": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "drug" } } },
          "then": { "properties": { "rxnorm": { "type": "string" } } },
          "else": { "properties": { "rxnorm": { "type": "null" } } }
        }
      ]
    },
    "guideline": {
      "type": "object",
      "required": ["name", "version", "year", "url", "doi", "pmid", "clinpgxUrl", "retrievedFrom", "accessed"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "url": { "type": "string", "pattern": "^https://" },
        "doi": { "type": "string", "pattern": "^10[.][0-9]{4}/" },
        "pmid": { "type": "string", "pattern": "^[0-9]+$" },
        "clinpgxUrl": { "type": "string", "pattern": "^https://" },
        "retrievedFrom": { "type": "string", "minLength": 1 },
        "accessed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "id", "drug", "rxnorm", "phenotypes", "activityScores", "population",
        "implication", "recommendation", "classification", "comments",
        "alternatives", "guideline", "mock"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^B1-[0-9]{3}$" },
        "drug": { "type": "string", "minLength": 1 },
        "rxnorm": { "type": "string", "pattern": "^[0-9]+$" },
        "phenotypes": { "$ref": "#/$defs/geneMap" },
        "activityScores": {
          "description": "Per gene, activity-score strings exactly as the guideline writes them (e.g. '>=3.0' with the guideline's symbol); empty where the guideline gives none.",
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "population": { "type": "string", "minLength": 1 },
        "implication": { "type": "object", "additionalProperties": { "type": "string" } },
        "recommendation": { "type": "string", "minLength": 1 },
        "classification": {
          "description": "Strength of recommendation exactly as the guideline states it.",
          "enum": ["Strong", "Moderate", "Optional", "No Recommendation", "n/a"]
        },
        "comments": { "type": "string" },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/alternative" } },
        "guideline": { "$ref": "#/$defs/guideline" },
        "mock": { "const": false }
      }
    }
  }
}
